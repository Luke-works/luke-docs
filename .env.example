# luke-docs authenticated server (server/index.mjs) — copy to .env for local runs.
# The site is public prose, but the deployed build is gated so only Lukeflow
# operators/admins can read it. Local authoring (`npm run docs:dev`) is UNGATED —
# these vars only affect `npm start` / `npm run serve`.

# Base URL of the core-engine that owns the admin identity (no trailing slash).
# Login is fail-closed until this is set.
DOCS_CORE_ENGINE_URL=http://localhost:8080

# Secret that signs session cookies. Leave unset locally (an ephemeral key is minted
# per boot); ALWAYS set a stable value in production (render.yaml uses generateValue).
# DOCS_SESSION_SECRET=

# How long a signed-in session lasts, in hours (default 12).
# DOCS_SESSION_TTL_HOURS=12

# Also admit org-admins (a `tenant-admin` role group), not just operators (default false).
# DOCS_ALLOW_TENANT_ADMIN=false

# Upstream call timeout to core-engine /api/me, ms (default 8000).
# DOCS_UPSTREAM_TIMEOUT_MS=8000

# Port the server listens on (Render provides PORT automatically; default 4173).
# PORT=4173
